# Backend API base URL for the deployed backend.
# Use your VPS IP while testing, then switch to your API domain after Nginx/SSL.
VITE_API_BASE_URL="http://YOUR_VPS_IP:4000"

# Knowledge base / Policies API (separate service)
VITE_POLICIES_API_BASE_URL="https://brainapi.blihmarketing.com/api/v1"

# Container runtime
PORT="3000"
HOST_PORT="3000"
APP_IMAGE="blih-hr-frontend"
APP_CONTAINER="blih-hr-frontend"

# Optional. Required only for live Gemini responses from /api/ai.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
